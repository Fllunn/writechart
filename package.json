{
  "name": "writechart",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "deps": "knip --strict --include unlisted,unresolved",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.0.0",
    "knip": "^6.46.0",
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.13"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "yarn@4.18.1"
}
