{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "env": ["DATABASE_URL_TEST"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL_TEST"],
      "passThroughEnv": ["PLAYWRIGHT_*"],
      "outputs": []
    }
  }
}
