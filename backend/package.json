{
  "name": "@writechart/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@writechart/shared": "workspace:*",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
