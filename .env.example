# Скопируй в .env и заполни. Файл .env в git не попадает.

# PostgreSQL (docker-compose.yml)
# Если на 5432 уже есть свой PostgreSQL (например, служба Windows), поставь другой порт
# (5433) в POSTGRES_PORT и в обоих URL: иначе соединение может уйти не в Docker.
POSTGRES_USER=writechart
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://writechart:@localhost:5432/writechart
DATABASE_URL_TEST=postgresql://writechart:@localhost:5432/writechart_test

# Бэкенд (backend/src/config/env.ts). Пусто — значение по умолчанию.
HOST=
PORT=
LOG_LEVEL=

# Прокси /api в dev-сервере фронта (frontend/vite.config.ts). Пусто — http://127.0.0.1:3000
API_PROXY_TARGET=
