{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    // Код ядра работает в браузере и в Node: без DOM и без типов Node.
    "lib": ["ES2024"],
    "types": [],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test-support"]
}
